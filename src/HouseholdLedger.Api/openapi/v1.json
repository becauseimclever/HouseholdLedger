  "components": {
    "schemas": {
      "AccountResponse": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The account identifier.",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "description": "The account display name."
          }
        },
        "description": "Represents one persisted account."
      },
      "AccountTransactionHistoryResponse": {
        "required": [
          "account",
          "transactions"
        ],
        "type": "object",
        "properties": {
          "account": {
            "description": "The selected account.",
            "$ref": "#/components/schemas/AccountResponse"
          },
          "transactions": {
            "type": "array",
