    "/api/v1/months/{year}/{month}/expense-summary": {
      "get": {
        "tags": [
          "MonthlyExpenseSummary"
        ],
        "summary": "Gets daily totals and month-to-date spending for one calendar month.",
        "parameters": [
          {
            "name": "year",
            "in": "path",
            "description": "The calendar year.",
            "required": true,
            "schema": {
              "maximum": 9999,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "month",
            "in": "path",
            "description": "The calendar month.",
            "required": true,
            "schema": {
              "maximum": 12,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One summary for every day in the month.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DailyExpenseSummaryResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
