                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/accounts/{accountId}/transactions": {
      "get": {
        "tags": [
          "AccountTransactions"
        ],
        "summary": "Gets one account and its matching transactions newest first.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "description": "The route-selected account identifier.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "From",
            "in": "query",
            "description": "Gets or initializes the inclusive first ledger date.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "To",
            "in": "query",
            "description": "Gets or initializes the inclusive final ledger date.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "Classification",
            "in": "query",
            "description": "Gets or initializes the required expense classification.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "MinimumAmount",
            "in": "query",
            "description": "Gets or initializes the inclusive minimum stored amount.",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": [
                "number",
                "string"
              ],
              "format": "double"
            }
          },
          {
            "name": "MaximumAmount",
            "in": "query",
            "description": "Gets or initializes the inclusive maximum stored amount.",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": [
                "number",
                "string"
              ],
              "format": "double"
            }
          },
          {
            "name": "Search",
            "in": "query",
            "description": "Gets or initializes text matched against visible transaction fields.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountTransactionHistoryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
