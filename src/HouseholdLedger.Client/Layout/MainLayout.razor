@inherits Microsoft.AspNetCore.Components.LayoutComponentBase

<div class="shell">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="shell-header">
        <div class="header-inner">
            <a class="wordmark" href="" aria-label="Household Ledger calendar">
                <span class="wordmark-mark" aria-hidden="true">HL</span>
                <span>Household Ledger</span>
            </a>
            <nav aria-label="Primary navigation">
                <Microsoft.AspNetCore.Components.Routing.NavLink href="" Match="Microsoft.AspNetCore.Components.Routing.NavLinkMatch.All">
                    Calendar
                </Microsoft.AspNetCore.Components.Routing.NavLink>
            </nav>
        </div>
    </header>

    <div class="shell-content" id="main-content" tabindex="-1">
        @Body
    </div>

    <footer class="shell-footer">
        <span>Household Ledger</span>
        <span class="footer-note">A quiet place for daily accounting.</span>
    </footer>
</div>