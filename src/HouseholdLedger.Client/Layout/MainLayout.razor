@inherits Microsoft.AspNetCore.Components.LayoutComponentBase
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web

<div class="workspace-shell">
    <header class="workspace-toolbar">
        <NavLink href="/" Match="NavLinkMatch.All" class="workspace-name" aria-label="HouseholdLedger home">HouseholdLedger</NavLink>
        <div class="workspace-tools" aria-label="Workspace panes">
            @if (InspectorAvailable)
            {
                <button class="pane-toggle"
                        type="button"
                        aria-controls="workspace-inspector"
                        aria-describedby="inspector-toggle-tooltip"
                        aria-expanded="@(inspectorExpanded ? "true" : "false")"
                        aria-label="@InspectorToggleLabel"
                        @onclick="ToggleInspector">
                    <span aria-hidden="true">
                        <Blazicons.Blazicon Svg="Blazicons.Lucide.Search" />
                    </span>
                    <span id="inspector-toggle-tooltip" class="pane-toggle-tooltip" role="tooltip">@InspectorToggleLabel</span>
                </button>
            }
        </div>
    </header>

    <div class="workspace-grid">
        <nav id="workspace-navigation"
             class="workspace-pane navigation-pane @(navigationExpanded ? null : "navigation-pane-collapsed")"
             aria-labelledby="@(navigationExpanded ? "navigation-heading" : null)"
             aria-label="@(navigationExpanded ? null : "Navigation")">
            <div class="navigation-pane-header">
                @if (navigationExpanded)
                {
                    <h2 id="navigation-heading">Navigation</h2>
                }
                <button class="pane-toggle navigation-toggle"
                        type="button"
                        aria-controls="workspace-navigation"
                        aria-describedby="navigation-toggle-tooltip"
                        aria-expanded="@(navigationExpanded ? "true" : "false")"
                        aria-label="@NavigationToggleLabel"
                        @onclick="ToggleNavigation">
                    <span aria-hidden="true">
                        <Blazicons.Blazicon Svg="@(navigationExpanded ? Blazicons.Lucide.ChevronLeft : Blazicons.Lucide.ChevronRight)" />
                    </span>
                    <span id="navigation-toggle-tooltip" class="pane-toggle-tooltip" role="tooltip">@NavigationToggleLabel</span>
                </button>
            </div>
            @if (navigationExpanded)
            {
                <ul class="workspace-navigation-list">
                <li>
                    <NavLink href="/" Match="NavLinkMatch.All" class="workspace-navigation-link">Home</NavLink>
                </li>
                <li class="accounts-navigation-branch @(AccountRouteSelected ? "current-navigation-branch" : null)">
                    <div class="accounts-navigation-heading">
                        <NavLink href="/accounts" class="workspace-navigation-link">Accounts</NavLink>
                        <button class="accounts-disclosure"
                                type="button"
                                aria-expanded="@(accountsBranchExpanded ? "true" : "false")"
                                aria-controls="accounts-navigation-list"
                                aria-label="@AccountsToggleLabel"
                                @onclick="ToggleAccounts">
                            <span aria-hidden="true">
                                <Blazicons.Blazicon Svg="@(accountsBranchExpanded ? Blazicons.Lucide.ChevronDown : Blazicons.Lucide.ChevronRight)" />
                            </span>
                        </button>
                    </div>
                    @if (accountsBranchExpanded)
                    {
                        <ul id="accounts-navigation-list" class="account-navigation-list">
                            @if (accountsLoading)
                            {
                                <li class="account-navigation-state" role="status" aria-live="polite">Loading accounts</li>
                            }
                            else if (accountsLoadError)
                            {
                                <li class="account-navigation-state account-navigation-error" role="alert">
                                    <span>Accounts are unavailable.</span>
                                    <button type="button" @onclick="LoadAccountsAsync">Try again</button>
                                </li>
                            }
                            else if (accounts.Count == 0)
                            {
                                <li class="account-navigation-state">No accounts yet.</li>
                            }
                            else
                            {
                                @foreach (var account in accounts)
                                {
                                    <li>
                                        <NavLink href="@($"/accounts/{account.Id}")" Match="NavLinkMatch.All" class="account-navigation-link">
                                            <span class="account-navigation-name" title="@account.Name">@account.Name</span>
                                            <span class="current-account-marker">Current</span>
                                        </NavLink>
                                    </li>
                                }
                            }
                        </ul>
                    }
                </li>
                <li>
                    <NavLink href="/settings" Match="NavLinkMatch.All" class="workspace-navigation-link">Settings</NavLink>
                </li>
                </ul>
            }
        </nav>
        <section id="workspace-main" class="workspace-main" aria-label="Primary workspace">
            @Body
        </section>
        <aside id="workspace-inspector" class="workspace-pane inspector-pane" aria-labelledby="inspector-heading" hidden="@(!InspectorAvailable || !inspectorExpanded)">
            <h2 id="inspector-heading">Inspector</h2>
            @if (InspectorAvailable && SelectedDate.Value is null)
            {
                <p class="inspector-empty-state">No calendar item selected</p>
            }
            else if (InspectorAvailable)
            {
                <HouseholdLedger.Client.Components.TransactionInspector />
            }
        </aside>
    </div>

    <footer class="workspace-auxiliary">
        <NavLink href="/open-source-notices" Match="NavLinkMatch.All" class="workspace-auxiliary-link">Open-source notices</NavLink>
    </footer>
</div>