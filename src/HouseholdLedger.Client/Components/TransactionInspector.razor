@using System.Globalization
@using HouseholdLedger.Api.Contracts
@using HouseholdLedger.Client.Formatting
@using Microsoft.AspNetCore.Components.Web

@if (SelectedDate.Value is not DateOnly selectedDate)
{
    <p class="inspector-empty-state">No calendar day selected</p>
}
else
{
    <section class="transaction-inspector" aria-labelledby="selected-day-heading">
        <h3 id="selected-day-heading">@selectedDate.ToString("D", CultureInfo.CurrentCulture)</h3>
        <p class="transaction-currency">Expenses in @CurrentCurrencyLabel</p>

        <section class="income-receipts" aria-labelledby="income-receipts-heading">
            <h4 id="income-receipts-heading">Income</h4>
            @if (isLoadingIncome)
            {
                <p role="status" aria-live="polite">Loading income</p>
            }
            else if (incomeLoadError)
            {
                <div role="alert"><p class="transaction-error">Income details are unavailable.</p><button class="secondary-action" type="button" @onclick="RetryIncomeAsync">Retry income</button></div>
            }
            else
            {
                @if (incomeReceipts.Count > 0)
                {
                    <section class="income-state" aria-labelledby="completed-income-heading">
                        <h5 id="completed-income-heading">Confirmed income</h5>
                        <ol class="income-receipt-list">
                            @foreach (var receipt in incomeReceipts)
                            {
                                <li>
                                    @if (editingReceiptId == receipt.Id)
                                    {
                                        <form class="income-edit-form" @onsubmit="ReviseIncomeAsync" @onsubmit:preventDefault="true" aria-label="Correct confirmed income">
                                            <label for="@GetElementId("income-date", receipt.Id)">Actual received date</label>
                                            <input id="@GetElementId("income-date", receipt.Id)" type="date" max="@TodayText" value="@receiptEditDateText" @onchange="UpdateReceiptDate" />
                                            <label for="@GetElementId("income-amount", receipt.Id)">Amount received (@CurrentCurrencyLabel)</label>
                                            <input id="@GetElementId("income-amount", receipt.Id)" type="text" inputmode="decimal" value="@receiptEditAmountText" @oninput="UpdateReceiptAmount" />
                                            @foreach (var allocation in receiptEditAllocations)
                                            {
                                                <div class="receipt-edit-allocation" @key="allocation.Id">
                                                    <label for="@GetElementId("income-account", allocation.Id)">Account</label>
                                                    <select id="@GetElementId("income-account", allocation.Id)" value="@allocation.AccountId" @onchange="args => UpdateReceiptAccount(allocation, args)">
                                                        <option value="">Choose an account</option>
                                                        @foreach (var account in accounts) { <option value="@account.Id">@account.Name</option> }
                                                    </select>
                                                    <label for="@GetElementId("income-allocation", allocation.Id)">Allocation amount (@CurrentCurrencyLabel)</label>
                                                    <input id="@GetElementId("income-allocation", allocation.Id)" type="text" inputmode="decimal" value="@allocation.AmountText" @oninput="args => UpdateReceiptAllocation(allocation, args)" />
                                                    <button type="button" disabled="@(receiptEditAllocations.Count == 1 || isMutating)" @onclick="() => RemoveReceiptAllocation(allocation)">Remove allocation</button>
                                                </div>
                                            }
                                            <button type="button" disabled="@isMutating" @onclick="AddReceiptAllocation">Add allocation</button>
                                            @if (incomeMutationError is not null) { <p class="transaction-error" role="alert">@incomeMutationError</p> }
                                            <div class="transaction-actions">
                                                <button type="submit" disabled="@isMutating">@(isMutating ? "Saving correction" : "Save correction")</button>
                                                <button class="secondary-action" type="button" disabled="@isMutating" @onclick="CancelReceiptEdit">Cancel</button>
                                            </div>
                                        </form>
                                    }
                                    else if (removingIncomeReceiptId == receipt.Id)
                                    {
                                        <div class="transaction-confirmation" role="group" aria-labelledby="@GetElementId("remove-income-heading", receipt.Id)">
                                            <p id="@GetElementId("remove-income-heading", receipt.Id)">Remove this confirmed income receipt of @MoneyFormatter.Format(receipt.NetIncome, CurrentCurrencyCode)? This changes recorded actual income.</p>
                                            <div class="transaction-actions">
                                                <button class="danger-action" type="button" disabled="@isMutating" @onclick="ConfirmRemoveIncomeAsync">@(isMutating ? "Removing" : "Remove receipt")</button>
                                                <button class="secondary-action" type="button" disabled="@isMutating" @onclick="CancelRemoveIncome">Cancel</button>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <strong>@GetScheduleName(receipt.ScheduleId)</strong>
                                        <span>@MoneyFormatter.Format(receipt.NetIncome, CurrentCurrencyCode)</span>
                                        <ul>@foreach (var allocation in receipt.Allocations) { <li>@GetAccountName(allocation.AccountId): @MoneyFormatter.Format(allocation.Amount, CurrentCurrencyCode)</li> }</ul>
                                        <div class="transaction-actions">
                                            <button class="secondary-action" type="button" disabled="@isMutating" @onclick="() => BeginReceiptEdit(receipt)">Correct</button>
                                            <button class="secondary-action" type="button" disabled="@isMutating" @onclick="() => BeginRemoveIncome(receipt.Id)">Remove</button>
                                        </div>
                                    }
                                </li>
                            }
                        </ol>
                    </section>
                }
                @if (pendingIncome.Count > 0)
                {
                    <details class="income-state pending-income-state">
                        <summary>Scheduled expectations (not received)</summary>
                        <ol class="income-receipt-list pending-income-list">
                            @foreach (var income in pendingIncome)
                            {
                                <li>
                                    <strong>@income.Name</strong><span>@MoneyFormatter.Format(income.NetIncome, CurrentCurrencyCode)</span>
                                    <ul>@foreach (var allocation in income.Allocations) { <li>@GetAccountName(allocation.AccountId): @MoneyFormatter.Format(allocation.Amount, CurrentCurrencyCode)</li> }</ul>
                                    <a class="content-link" href="@($"/income-receipts/{selectedDate.Year}/{selectedDate.Month}/{selectedDate.Day}?scheduleId={income.Id}")">Use schedule as receipt suggestion</a>
                                </li>
                            }
                        </ol>
                    </details>
                }
                <p>Schedules never record receipts. Account destinations are not savings contributions.</p>
            }
            <a class="content-link" href="@($"/income-receipts/{selectedDate.Year}/{selectedDate.Month}/{selectedDate.Day}")">Confirm actual received income</a>
            @if (incomeMutationStatus is not null) { <p role="status">@incomeMutationStatus</p> }
        </section>

        @if (isLoadingAccounts)
        {
            <p class="account-load-state" role="status" aria-live="polite">Loading accounts</p>
        }
        else if (accountLoadError)
        {
            <div class="account-load-state" role="alert">
                <p>Accounts are unavailable. Transactions may still be viewed.</p>
                <button class="secondary-action" type="button" @onclick="RetryAccountsAsync">Try again</button>
            </div>
        }
        else if (accounts.Count == 0)
        {
            <p class="account-load-state">Add an account before recording an expense. <a class="content-link" href="/accounts">Go to Accounts</a>.</p>
        }
        else
        {
            <form @onsubmit="SaveAsync" @onsubmit:preventDefault="true" aria-label="Record an expense">
                <div class="transaction-field">
                    <label for="transaction-account">Account</label>
                    <select id="transaction-account" name="account" required value="@accountId" @onchange="UpdateAccount" aria-invalid="@HasAccountError" aria-describedby="transaction-account-error">
                        <option value="">Choose an account</option>
                        @foreach (var account in accounts)
                        {
                            <option value="@account.Id">@account.Name</option>
                        }
                    </select>
                    @if (accountError is not null)
                    {
                        <p id="transaction-account-error" class="transaction-error">@accountError</p>
                    }
                </div>

                <div class="transaction-field">
                    <label for="transaction-amount">Amount (@CurrentCurrencyLabel)</label>
                    <input id="transaction-amount" name="amount" type="text" inputmode="decimal" autocomplete="off" value="@amountText" @oninput="UpdateAmount" aria-invalid="@HasAmountError" aria-describedby="transaction-amount-error" />
                    @if (amountError is not null)
                    {
                        <p id="transaction-amount-error" class="transaction-error">@amountError</p>
                    }
                </div>

                <div class="transaction-field">
                    <label for="transaction-classification">Classification</label>
                    <select id="transaction-classification" name="classification" value="@classification" @onchange="UpdateClassification" aria-invalid="@HasClassificationError" aria-describedby="transaction-classification-error">
                        <option value="">Choose a classification</option>
                        @foreach (var option in Classifications)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                    @if (classificationError is not null)
                    {
                        <p id="transaction-classification-error" class="transaction-error">@classificationError</p>
                    }
                    <p>Examples: Necessities for groceries or utilities; Optional for convenience purchases; Culture for books or events; Unexpected for unplanned urgent costs.</p>
                </div>

                <div class="transaction-field">
                    <label for="transaction-description">Description (optional)</label>
                    <input id="transaction-description" name="description" maxlength="200" autocomplete="off" value="@descriptionText" @oninput="UpdateDescription" aria-invalid="@(descriptionError is null ? "false" : "true")" aria-describedby="transaction-description-help transaction-description-error" />
                    <small id="transaction-description-help">Up to 200 characters.</small>
                    @if (descriptionError is not null) { <p id="transaction-description-error" class="transaction-error">@descriptionError</p> }
                </div>

                <button type="submit" disabled="@isSaving">@(isSaving ? "Saving" : "Save expense")</button>
            </form>
        }

        <div class="transaction-status" role="status" aria-live="polite">
            @if (isLoading)
            {
                <p>Loading transactions</p>
            }
            else if (loadError)
            {
                <p>Transactions are unavailable. Select the day again to retry.</p>
            }
            else if (transactions.Count == 0)
            {
                <p>No transactions recorded for this day.</p>
            }
            else
            {
                <ol class="transaction-list">
                    @foreach (var transaction in transactions)
                    {
                        <li class="transaction-item">
                            @if (editingTransactionId == transaction.Id)
                            {
                                <form class="transaction-edit-form" @onsubmit="ReviseAsync" @onsubmit:preventDefault="true" aria-label="Edit expense">
                                    <div class="transaction-field">
                                        <label for="@GetElementId("edit-account", transaction.Id)">Account</label>
                                        <select id="@GetElementId("edit-account", transaction.Id)" required value="@editAccountId" @onchange="UpdateEditAccount" aria-invalid="@(editAccountError is null ? "false" : "true")">
                                            <option value="">Choose an account</option>
                                            @foreach (var account in accounts)
                                            {
                                                <option value="@account.Id">@account.Name</option>
                                            }
                                        </select>
                                        @if (editAccountError is not null)
                                        {
                                            <p class="transaction-error">@editAccountError</p>
                                        }
                                    </div>
                                    <div class="transaction-field">
                                        <label for="@GetElementId("edit-amount", transaction.Id)">Amount (@CurrentCurrencyLabel)</label>
                                        <input id="@GetElementId("edit-amount", transaction.Id)" type="text" inputmode="decimal" autocomplete="off" value="@editAmountText" @oninput="UpdateEditAmount" aria-invalid="@(editAmountError is null ? "false" : "true")" />
                                        @if (editAmountError is not null)
                                        {
                                            <p class="transaction-error">@editAmountError</p>
                                        }
                                    </div>
                                    <div class="transaction-field">
                                        <label for="@GetElementId("edit-classification", transaction.Id)">Classification</label>
                                        <select id="@GetElementId("edit-classification", transaction.Id)" value="@editClassification" @onchange="UpdateEditClassification" aria-invalid="@(editClassificationError is null ? "false" : "true")">
                                            @foreach (var option in Classifications)
                                            {
                                                <option value="@option">@option</option>
                                            }
                                        </select>
                                        @if (editClassificationError is not null)
                                        {
                                            <p class="transaction-error">@editClassificationError</p>
                                        }
                                    </div>
                                    <div class="transaction-field">
                                        <label for="@GetElementId("edit-description", transaction.Id)">Description (optional)</label>
                                        <input id="@GetElementId("edit-description", transaction.Id)" maxlength="200" autocomplete="off" value="@editDescriptionText" @oninput="UpdateEditDescription" aria-invalid="@(editDescriptionError is null ? "false" : "true")" aria-describedby="@GetElementId("edit-description-help", transaction.Id) @GetElementId("edit-description-error", transaction.Id)" />
                                        <small id="@GetElementId("edit-description-help", transaction.Id)">Up to 200 characters.</small>
                                        @if (editDescriptionError is not null) { <p id="@GetElementId("edit-description-error", transaction.Id)" class="transaction-error">@editDescriptionError</p> }
                                    </div>
                                    <div class="transaction-actions">
                                        <button type="submit" disabled="@isMutating">@(isMutating ? "Saving changes" : "Save changes")</button>
                                        <button class="secondary-action" type="button" disabled="@isMutating" @onclick="CancelEdit">Cancel</button>
                                    </div>
                                </form>
                            }
                            else if (removingTransactionId == transaction.Id)
                            {
                                <div class="transaction-confirmation" role="group" aria-labelledby="@GetElementId("remove-heading", transaction.Id)">
                                    <p id="@GetElementId("remove-heading", transaction.Id)">Permanently remove @transaction.Classification @MoneyFormatter.Format(transaction.Amount, CurrentCurrencyCode)?</p>
                                    <div class="transaction-actions">
                                        <button class="danger-action" type="button" disabled="@isMutating" @onclick="ConfirmRemoveAsync">@(isMutating ? "Removing" : "Remove permanently")</button>
                                        <button class="secondary-action" type="button" disabled="@isMutating" @onclick="CancelRemove">Cancel</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="transaction-summary">
                                    <span><span>@transaction.Classification</span><small>@transaction.AccountName</small>@if (!string.IsNullOrWhiteSpace(transaction.Description)) { <small>@transaction.Description</small> }</span>
                                    <strong>@MoneyFormatter.Format(transaction.Amount, CurrentCurrencyCode)</strong>
                                </div>
                                <div class="transaction-actions">
                                    <button class="secondary-action" type="button" @onclick="() => BeginEdit(transaction)">Edit</button>
                                    <button class="secondary-action" type="button" @onclick="() => BeginRemove(transaction.Id)">Remove</button>
                                </div>
                            }
                        </li>
                    }
                </ol>
            }

            @if (saveError is not null)
            {
                <p class="transaction-error">@saveError</p>
            }
            @if (mutationError is not null)
            {
                <p class="transaction-error">@mutationError</p>
            }
            @if (mutationStatus is not null)
            {
                <p>@mutationStatus</p>
            }
        </div>
    </section>
}
