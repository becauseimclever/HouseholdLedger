<Microsoft.AspNetCore.Components.Routing.Router AppAssembly="@typeof(Program).Assembly">
    <Found Context="routeData">
        <Microsoft.AspNetCore.Components.RouteView RouteData="routeData"
                                                   DefaultLayout="@typeof(Layout.MainLayout)" />
        <Microsoft.AspNetCore.Components.Routing.FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <Microsoft.AspNetCore.Components.LayoutView Layout="@typeof(Layout.MainLayout)">
            <HouseholdLedger.Client.Pages.NotFoundPage />
        </Microsoft.AspNetCore.Components.LayoutView>
    </NotFound>
</Microsoft.AspNetCore.Components.Routing.Router>