{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run HouseholdLedger locally",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"run",
				"--project",
				"src\\HouseholdLedger.Api",
				"--no-restore",
				"--",
				"--environment",
				"Development",
				"--urls",
				"https://localhost:7241"
			],
			"isBackground": true,
			"problemMatcher": [
				"$msCompile"
			]
		}
	]
}