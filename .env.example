# Non-secret deployment configuration only. Keep secret files outside the checkout.
HL_IMAGE=householdledger:baseline
HL_HOSTNAME=ledger.home.example
HL_AUTHORITY=https://identity.home.example/application/o/householdledger/
HL_CLIENT_ID=householdledger
HL_OWNER_SUBJECT=replace-with-the-owners-exact-oidc-sub
# Actual source IP seen by the container from your TLS reverse proxy.
HL_PROXY_IP=replace-with-proxy-ip
HL_POSTGRES_PASSWORD_FILE=/absolute/private/path/postgres-password
HL_CONNECTION_STRING_FILE=/absolute/private/path/connection-string
HL_OIDC_SECRET_FILE=/absolute/private/path/oidc-client-secret
